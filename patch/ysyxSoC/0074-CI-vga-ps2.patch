From 66baecc1e9438c28514d3d390c57669b2b847188 Mon Sep 17 00:00:00 2001
From: 11111-dongfengjun <dongfengjun2024@163.com>
Date: Sat, 25 Oct 2025 16:45:15 +0800
Subject: [PATCH 74/74] CI -vga ps2

---
 perip/ps2/ps2_top_apb.v | 173 ++++++++++++----------------------------
 perip/vga/vga_top_apb.v | 126 +++++++++++++++++++----------
 2 files changed, 137 insertions(+), 162 deletions(-)

diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index a322616e..765d34ab 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -16,149 +16,80 @@ module ps2_top_apb(
   input         ps2_data
 );
 
-typedef enum[1:0] { wait_t, wait1_t, wait2_t} state_t;
-localparam BREAK = 8'hF0;
-localparam EXP = 8'hE0;
-reg [1:0]state;
-reg [3:0]counter;
-reg [7:0]buffer;
-reg [7:0]buffer1;
-reg [7:0]buffer2;
-reg ready;
-reg [31:0]rdata;
-wire is_read = (in_psel && !in_penable) && !in_pwrite;
+reg [9:0] buffer;
+reg [3:0] counter;
+reg [7:0] fifo[15:0];
+reg [3:0] r_cnt,w_cnt;
+reg empty;
 
-always@(posedge clock or posedge reset) begin
-	if(reset) begin
-		in_pready <= 1'b0;
-		in_prdata <= 32'h0;
-	end
-	else if(in_penable && ready) begin
-		in_pready <= 1'b1;
-		in_prdata <= rdata;
-	end
-	else begin
-		in_pready <= 1'b0;
-		in_prdata <= 32'h0;
-	end
-end
+parameter IDLE = 1'b0,READ = 1'b1;
+reg state;
 
-//state
-always@(negedge ps2_clk or posedge reset) begin
-	if(reset) state <= wait_t;
+always @(posedge clock or posedge reset) begin
+	if(reset) state <= IDLE;
 	else begin
-		case (state)
-			wait_t : state <= (counter == 4'd10 && buffer == EXP) ? wait1_t : (counter == 4'd10 && buffer == BREAK) ? wait2_t : state;
-			wait1_t: state <= (counter != 4'd10) ? state : (counter == 4'd10 && buffer1 == BREAK) ? wait2_t : wait_t;
-			wait2_t: state <= (counter == 4'd10) ? wait_t : state;
-			default: state <= state;
+		case(state)
+			IDLE : state <= (in_psel && !in_pwrite) ? READ : IDLE;
+			READ : state <= IDLE;
+			default : state <= IDLE;
 		endcase
 	end
 end
 
-always@ (negedge ps2_clk or posedge is_read) begin
-	if(reset) begin
-		ready <= 1'b0;
-		rdata <= 32'h0;
-	end
-	else if(is_read) begin
-	  ready <= 1'b0;
-    rdata <= 32'h0;
-	end
-	else begin
-		case (state)
-			wait_t: begin
-				if(counter == 4'd10 && buffer != EXP && buffer != BREAK) begin
-					ready <= 1'b1;
-					rdata <= {24'h0,buffer};
-				end
-				else begin
-					ready <= 1'b0;
-					rdata <= 32'h0;
-				end
-			end
-			wait1_t: begin
-        if(counter == 4'd10 && buffer == EXP && buffer1 != BREAK) begin
-          ready <= 1'b1;
-          rdata <= {16'h0,buffer,buffer1};
-        end
-				else begin
-          ready <= 1'b0;
-          rdata <= 32'h0;
-        end
-      end
-			wait2_t: begin
-				if(counter == 4'd10 && buffer == EXP && buffer1 == BREAK) begin
-					ready <= 1'b1;
-					rdata <= {8'b0, buffer, buffer1, buffer2};
-				end
-				else if(counter == 4'd10 && buffer == BREAK) begin
-          ready <= 1'b1;
-          rdata <= {16'b0, buffer, buffer2};
-        end
-				else begin
-					ready <= 1'b0;
-					rdata <= 32'h0;
-				end
-			end
-			default: begin
-				ready <= 1'b0;
-				rdata <= 32'h0;
-			end
-		endcase
-	end
+assign in_pready = (state == READ);
+assign in_prdata = (state == READ) ? ((!empty) ? {24'b0,fifo[r_cnt]} : 32'b0) : 32'b0;
+
+reg [2:0] ps2_clk_sync;
+always @(posedge clock) begin
+	ps2_clk_sync <= {ps2_clk_sync[1:0],ps2_clk};
 end
+wire sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
 
-always@(negedge ps2_clk or posedge reset) begin
-	if(reset) begin 
+always @(posedge clock or posedge reset) begin
+	if(reset) begin
 		counter <= 4'd0;
+		buffer <= 10'b0;
 	end
 	else begin
-		case(state)
-			wait_t: counter <= (counter < 4'd10) ? counter + 4'd1 : 4'd0;
-			wait1_t: counter <= (counter < 4'd10) ? counter + 4'd1 : 4'd0;
-			wait2_t: counter <= (counter < 4'd10) ? counter + 4'd1 : 4'd0;
-			default: begin
+		if(sampling) begin
+			if(counter == 4'd10) begin
 				counter <= 4'd0;
 			end
-		endcase
+			else begin
+				counter <= counter + 1;
+				buffer[counter] <= ps2_data;
+			end
+		end
 	end
 end
 
-always@(negedge ps2_clk or posedge reset) begin
-	if(reset) begin 
-		buffer <= 8'h0;
-		buffer1 <= 8'h0;
-		buffer2 <= 8'h0;
+integer i;
+always @(posedge clock or posedge reset) begin
+	if(reset) begin
+		counter <= 4'b0;
+		w_cnt <= 4'b0;
+		r_cnt <= 4'b0;
+		empty <= 1'b1;
+		for(i = 0; i < 8; i = i + 1) begin
+			fifo[i] <= 8'b0;
+		end
 	end
 	else begin
-		case(state)
-			wait_t: begin
-				if(is_read) begin
-					buffer <= 8'h0;
-					buffer1 <= 8'h0;
-					buffer2 <= 8'h0;
-				end
-				if(counter >= 4'd1 && counter <= 4'd8) begin
-					buffer <= {ps2_data,buffer[7:1]};
-				end
-			end
-			wait1_t: begin
-				if(counter >= 4'd1 && counter <= 4'd8) begin
-					buffer1 <= {ps2_data,buffer1[7:1]};
-				end
-			end
-			wait2_t: begin
-				if(counter >= 4'd1 && counter <= 4'd8) begin
-					buffer2 <= {ps2_data,buffer2[7:1]};
+		if(sampling) begin
+			if(counter == 4'd10) begin
+				if((!buffer[0]) && (ps2_data) && (^buffer[9:1])) begin
+					fifo[w_cnt] <= buffer[8:1];
+					w_cnt <= w_cnt + 1;
+					empty <= 1'b0;
 				end
 			end
-			default: begin
-				buffer <= buffer;
-				buffer1 <= buffer1;
-				buffer2 <= buffer2;
+		end
+		if(in_penable & in_pready & (!empty)) begin
+			r_cnt <= r_cnt + 1;
+			if(w_cnt == (r_cnt + 1)) begin
+				empty <= 1'b1;
 			end
-		endcase
+		end
 	end
 end
 
diff --git a/perip/vga/vga_top_apb.v b/perip/vga/vga_top_apb.v
index 68047063..f2137eb7 100644
--- a/perip/vga/vga_top_apb.v
+++ b/perip/vga/vga_top_apb.v
@@ -20,30 +20,42 @@ module vga_top_apb(
   output        vga_valid
 );
 
+
+	wire is_sync = (in_paddr == 32'h211FFFF4);
 	wire is_write = (in_psel && !in_penable) && in_pwrite && ((in_paddr >= 32'h21000000) && (in_paddr < 32'h21200000));
-	wire [31:0] addr = (in_paddr - 32'h21000000) / 4;
 	assign in_pready = ready;
-	reg [31:0] data [524287:0];
+	reg [31:0] data [2 ** 21 - 1:0];
+	reg sync_reg;
 	reg ready;
 	
 	integer i;
-	always@(posedge clock or posedge reset) begin
+	always @(posedge clock or posedge reset) begin
 		if(reset) begin
-			ready <= 1'b0;
-      for (i = 0; i < 524288; i = i + 1) begin
+			sync_reg <= 1'b0;
+      for (i = 0; i < 2 ** 21; i = i + 1) begin
         data[i] = 32'h0;
       end
 		end
 		else if(is_write) begin
-			data[addr] <= in_pwdata;
-			ready <= 1'b1;
+			if(is_sync) begin
+	      sync_reg <= in_pwdata[0];
+			end
+			else begin
+				sync_reg <= 1'b0;
+				data[in_paddr[22:2]] <= in_pwdata;
+			end
 		end
+	end
+
+	always @(posedge clock or posedge reset) begin
+		if(reset) ready <= 1'b0;
 		else begin
-			ready <= 1'b0;
+			if(is_write) ready <= 1'b1;
+			else ready <= 1'b0;
 		end
 	end
-
-  //640x480分辨率下的VGA参数设置
+  
+	//640x480分辨率下的VGA参数设置
   parameter    h_frontporch = 96;
   parameter    h_active = 144;
   parameter    h_backporch = 784;
@@ -57,45 +69,77 @@ module vga_top_apb(
   //像素计数值
   reg [9:0]    x_cnt;
   reg [9:0]    y_cnt;
-  wire         h_valid;
+  reg [20:0]   cnt;
+	wire         h_valid;
   wire         v_valid;
 
-  always @(posedge reset or posedge clock) //行像素计数
-      if (reset == 1'b1)
-        x_cnt <= 1;
-      else
-      begin
-        if (x_cnt == h_total)
-            x_cnt <= 1;
-        else
-            x_cnt <= x_cnt + 10'd1;
-      end
+  always @(posedge clock or posedge reset) begin //行像素计数
+    if(reset) begin
+      x_cnt <= 0;
+		end
+    else begin
+			if(x_cnt == h_total) begin
+				if(y_cnt == v_total) begin
+					x_cnt <= 0;
+				end
+				else begin
+					x_cnt <= 1;
+				end
+			end
+			else if(x_cnt > 0) begin
+				x_cnt <= x_cnt + 1;
+			end
+      else begin
+				if(sync_reg) begin
+					x_cnt <= 1;
+				end
+			end
+    end
+	end
 
-  always @(posedge clock)  //列像素计数
-      if (reset == 1'b1)
-        y_cnt <= 1;
-      else
-      begin
-        if (y_cnt == v_total & x_cnt == h_total)
-            y_cnt <= 1;
-        else if (x_cnt == h_total)
-            y_cnt <= y_cnt + 10'd1;
-      end
-  //生成同步信号
+  always @(posedge clock or posedge reset) begin //列像素计数
+    if(reset) begin
+      y_cnt <= 1;
+		end
+    else begin
+      if(x_cnt == h_total) begin
+				if(y_cnt == v_total) begin
+					y_cnt <= 1;
+				end
+				else begin
+					y_cnt <= y_cnt + 1;
+				end
+			end
+    end
+	end
+
+	always @(posedge clock or posedge reset) begin
+		if(reset) begin
+			cnt <= 0;
+		end
+		else begin
+			if(y_cnt == v_total) begin
+				cnt <= 0;
+			end
+			else if(vga_valid) begin
+				cnt <= cnt + 1;
+			end
+			else begin
+				cnt <= cnt;
+			end
+		end
+	end
+
+//生成同步信号
   assign vga_hsync = (x_cnt > h_frontporch);
   assign vga_vsync = (y_cnt > v_frontporch);
-  //生成消隐信号
+//生成消隐信号
   assign h_valid = (x_cnt > h_active) & (x_cnt <= h_backporch);
   assign v_valid = (y_cnt > v_active) & (y_cnt <= v_backporch);
   assign vga_valid = h_valid & v_valid;
-  //计算当前有效像素坐标
-	wire [9:0]h_addr = h_valid ? (x_cnt - 10'd145) : {10{1'b0}};
-	wire [9:0]v_addr = v_valid ? (y_cnt - 10'd36) : {10{1'b0}};
-	wire [18:0]vga_addr = {9'b0,v_addr} * 640 + {9'b0,h_addr};
-
 //设置输出的颜色值
-	assign vga_r = data[vga_addr][23:16];
-	assign vga_g = data[vga_addr][15:8];
-	assign vga_b = data[vga_addr][7:0];
+	assign vga_r = vga_valid ? data[cnt][23:16] : 8'b0;
+	assign vga_g = vga_valid ? data[cnt][15: 8] : 8'b0;
+	assign vga_b = vga_valid ? data[cnt][ 7: 0] : 8'b0;
 
 endmodule
